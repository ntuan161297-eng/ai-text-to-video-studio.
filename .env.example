# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - AI TEXT-TO-VIDEO MULTI-USER APP
# ==========================================================

# 1. Server & Networking
PORT=4000
APP_URL=http://localhost:4000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 2. Database (PostgreSQL)
# Trên Docker: postgresql://postgres:postgres@postgres:5432/ai_video_db
# Trên Local standalone: Để trống để tự động dùng local file database (data/local_db.json)
DATABASE_URL=

# 3. Queue & Background Worker (In-Process hoặc Redis BullMQ)
VIDEO_WORKER_CONCURRENCY=1
USE_REDIS=false
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379

# 4. Storage Provider (local | s3)
# 'local' cho development, 's3' cho AWS S3 / Cloudflare R2 / MinIO
STORAGE_PROVIDER=local
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Cấu hình S3 (Chỉ cần khi STORAGE_PROVIDER=s3)
S3_BUCKET=my-video-bucket
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://my-video-bucket.s3.amazonaws.com

# 5. AI Providers (Tuỳ chọn - Hệ thống mặc định có sẵn Neural TTS tiếng Việt)
TTS_PROVIDER=edge
LLM_PROVIDER=local
VISUAL_PROVIDER=svg

# API Keys AI bên ngoài (nếu sử dụng)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
