# 1. Thu mục thư viện (Rất nặng, người dùng sẽ tự tải bằng npm install)
node_modules/
web/node_modules/
.pnpm-store/

# 2. File bí mật & Cấu hình môi trường (TUYỆT ĐỐI KHÔNG PUSH LÊN GIT)
.env
.env.local
.env.development.local
.env.production.local

# 3. File video đã render và thư mục tạm (Rất nặng)
output/
